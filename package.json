{
  "name": "genefoundry-landing",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build.mjs",
    "preview": "vite preview",
    "type-check": "vue-tsc --noEmit -p tsconfig.json --composite false",
    "lint": "eslint .",
    "format": "node scripts/format.mjs --write",
    "generate-pwa-assets": "pwa-assets-generator",
    "generate-og-image": "node scripts/generate-og-image.js",
    "lint:check": "eslint .",
    "test": "vitest run && npm run test:release",
    "test:e2e": "playwright test",
    "test:e2e:artifacts": "TEST_PHASE=static playwright test",
    "test:e2e:http": "TEST_PHASE=http playwright test",
    "test:e2e:all": "node scripts/test-e2e.mjs",
    "build:matrix": "node scripts/build-matrix.mjs",
    "check:artifacts": "node scripts/validate-artifacts.mjs",
    "format:check": "node scripts/format.mjs",
    "lint:fix": "eslint . --fix",
    "test:release": "node --test tests/*.mjs && bash tests/test-compose-production.sh && bash tests/test-workflow-controls.sh",
    "audit:lighthouse": "node scripts/audit-lighthouse.mjs"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.2",
    "@vue/server-renderer": "^3.5.41",
    "lucide-vue-next": "^0.577.0",
    "vue": "^3.5.41"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.63.0",
    "@rushstack/eslint-patch": "^1.16.1",
    "@types/node": "^26.2.0",
    "@vite-pwa/assets-generator": "^1.0.2",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.8.1",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "sharp": "^0.35.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "vite-plugin-compression2": "^2.5.3",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "5.0.0",
    "vue-tsc": "^3.3.10"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "overrides": {
    "brace-expansion": "^5.0.9",
    "fast-uri": "^3.1.4",
    "nanoid": "^3.3.17",
    "sharp": "^0.35.2",
    "filelist": {
      "minimatch": "^10.2.5"
    }
  }
}
